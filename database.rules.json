{
  "rules": {
    ".read": true,
    ".write": false,

    "groups": {
      "$groupId": {
        ".write": true
      }
    },
    "meetingNotes": {
      ".write": true
    },
    "calendarEntries": {
      ".write": true
    },
    "notifications": {
      ".write": true
    },
    "statusColors": {
      ".write": true
    },
    "clientColors": {
      ".write": true
    },
    "serviceColors": {
      ".write": true
    },

    "taskStatuses": {
      ".indexOn": ["groupId"]
    },
    "tasks": {
      ".indexOn": ["groupId"]
    },
    "clients": {
      ".indexOn": ["groupId"]
    },
    "services": {
      ".indexOn": ["groupId"]
    },
    "departments": {
      ".indexOn": ["groupId"]
    }
  }
}
